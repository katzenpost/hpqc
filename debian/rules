#!/usr/bin/make -f

export DH_GOLANG_INSTALL_ALL := 1
export SOURCE_DATE_EPOCH ?= $(shell dpkg-parsechangelog -STimestamp)
export PYBUILD_NAME := hpqc

%:
	dh $@ --buildsystem=golang --with=golang,python3

override_dh_golang:
	:

override_dh_auto_build:
	dh_auto_build --buildsystem=pybuild --sourcedirectory=py

override_dh_auto_test:
	:

override_dh_auto_install:
	dh_auto_install
	dh_auto_install --buildsystem=pybuild --sourcedirectory=py

override_dh_auto_clean:
	dh_auto_clean
	dh_auto_clean --buildsystem=pybuild --sourcedirectory=py
